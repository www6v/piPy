{
  "defaultProvider": "anthropic",
  "defaultModel": "claude-sonnet-4-6",
  "defaultThinkingLevel": "medium",
  "quietStartup": false,
  "enableSkillCommands": true,
  "skills": [
    "~/.claude/skills"
  ],
  "prompts": [],
  "extensions": [],
  "steeringMode": "one-at-a-time",
  "followUpMode": "one-at-a-time",
  "compaction": {
    "enabled": true,
    "reserveTokens": 16384,
    "keepRecentTokens": 20000
  },
  "retry": {
    "enabled": true,
    "maxRetries": 3,
    "baseDelayMs": 2000
  }
}
